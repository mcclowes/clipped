# SwiftFormat configuration for Clipped

--swiftversion 6.0
--minversion 0.54

# Rules
--enable isEmpty
# wrapIfStatementBodies (default-on since SwiftFormat 0.62) conflicts with the codebase's
# single-line `if condition { return value }` idiom.
--disable blankLinesBetweenChainedFunctions,wrapIfStatementBodies

# Formatting options
--indent 4
--indentcase false
--trimwhitespace always
--voidtype void
--nospaceoperators ..., ..<
--commas always
--stripunusedargs closure-only
--maxwidth 120
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen balanced

# File options
--exclude .build,DerivedData,Clipped/Clipped.xcodeproj
